  "closure_field_definitions": {
    "reviewed_migration_origin": {
      "purpose": "authoritative link of migration source evidence to reviewed migration signature",
      "required_evidence": "existing immutable migration-origin artifact with explicit migration signature",
      "deterministic_evidence_sources": [
        "E.2B2R migration census snapshot",
        "marked migration observation artifacts",
        "current-mint lineage evidence",
        "B2M retained-acquisition evidence",
        "frozen cohort manifests",
        "source checkpoint/high-water artifacts"
      ],
      "evidence_is_deterministic": true,
      "verification": "artifact_digest and candidate_id must match deterministic identifier",
      "failure_conditions": [
        "no_matching_artifact",
        "evidence_digest_mismatch",
        "candidate_origin_inconsistent"
      ]
    },
    "human_approval_decision_record": {
      "purpose": "human disposition explicitly recorded after technical evidence collection",
      "required_evidence": "human_decision_contract-compliant record artifact per member",
      "evidence_is_deterministic": false,
      "verification": "decision must be one of APPROVED/DENIED/REQUIRES_REVIEW/HUMAN_DECISIONS_REQUIRED and include reviewer_id and review_timestamp_utc",
      "failure_conditions": [
        "unsupported_disposition",
        "missing_reviewer_identity_when_required",
        "record_tampered"
      ]
    },
    "immutable_source_checkpoint_id": {
      "purpose": "binds evidence to a frozen source checkpoint/high-water boundary",
      "required_evidence": "checkpoint artifact containing source checkpoint identity and digest",
      "evidence_is_deterministic": true,
      "verification": "checkpoint_id must be stable for member, high-water binding deterministic, and artifact digest verified",
      "failure_conditions": [
        "checkpoint_missing",
        "checkpoint_digest_mismatch",
        "boundary_drift"
      ]
    }
  },

  "queries": {
    "existing_oldest": "SELECT mint FROM wt_walkback_queue WHERE status='waiting' AND path_state='WAITING_FOR_CREATE_ANCHOR' AND (create_anchor_signature IS NULL OR create_anchor_audit_state='MISSING_OR_MALFORMED') ORDER BY enqueued_at ASC LIMIT 1",
    "least_recent_lookup": "SELECT mint FROM wt_walkback_queue WHERE status='waiting' AND path_state='WAITING_FOR_CREATE_ANCHOR' AND (create_anchor_signature IS NULL OR create_anchor_audit_state='MISSING_OR_MALFORMED') ORDER BY last_anchor_lookup_at ASC,mint ASC LIMIT 1",
    "fewest_lookup_attempts": "SELECT mint FROM wt_walkback_queue WHERE status='waiting' AND path_state='WAITING_FOR_CREATE_ANCHOR' AND (create_anchor_signature IS NULL OR create_anchor_audit_state='MISSING_OR_MALFORMED') ORDER BY anchor_lookup_attempts ASC,enqueued_at ASC LIMIT 1",
    "retry_due": "SELECT mint FROM wt_walkback_queue WHERE status='waiting' AND path_state='WAITING_FOR_CREATE_ANCHOR' AND (create_anchor_signature IS NULL OR create_anchor_audit_state='MISSING_OR_MALFORMED') AND (next_retry_at IS NULL OR next_retry_at<=1) ORDER BY next_retry_at ASC,mint ASC LIMIT 1",
    "updated_order": "SELECT mint FROM wt_walkback_queue WHERE status='waiting' AND path_state='WAITING_FOR_CREATE_ANCHOR' AND (create_anchor_signature IS NULL OR create_anchor_audit_state='MISSING_OR_MALFORMED') ORDER BY updated_at ASC,mint ASC LIMIT 1"
